# 本地 Elysia API；容器内固定为 127.0.0.1:3000，Nginx 对外监听 8000
HOST=127.0.0.1
PORT=3000

# SQLite、密钥和标题索引目录；必须持久化备份整个目录
DATA_DIR=./data

# 反向代理时填写浏览器实际访问的 origin（不含路径），用于跨站请求校验
# PUBLIC_ORIGIN=https://bangumi.example.com

# HTTPS 部署设为 true；HTTP 局域网部署保持 false
COOKIE_SECURE=false

# 本地 API 默认不信任代理头；容器内部由启动脚本启用，仅接受回环代理
TRUST_PROXY=false

# Docker Compose 镜像仓库与本地绑定（首次初始化建议保持仅本机）
# BANGARR_IMAGE=ghcr.io/apocalypsor/bangarr
# BANGARR_TAG=latest
# BIND_ADDRESS=127.0.0.1
# HOST_PORT=8000
# PUID=1000
# PGID=1000
